<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="UiButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:backgroundTint">@null</item>
    </style>
    <style name="UiPrimary" parent="UiButton">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
    <style name="UiSecondary" parent="UiButton">
        <item name="android:background">@drawable/bg_btn_secondary</item>
        <item name="android:textColor">@color/primary</item>
    </style>
    <style name="UiTool" parent="UiButton">
        <item name="android:layout_width">46dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:textColor">@color/toolbar_icon</item>
        <item name="android:textSize">17sp</item>
        <item name="android:focusable">false</item>
    </style>
    <style name="UiField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">18dp</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textColorHint">@color/text_light</item>
        <item name="android:inputType">text</item>
        <item name="android:importantForAutofill">no</item>
    </style>
    <style name="UiNav">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">11sp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">@color/nav_text</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/bg_nav_touch</item>
    </style>
    <style name="UiToolbarAction" parent="UiButton">
        <item name="android:background">@drawable/bg_toolbar_action</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/toolbar_action_text</item>
        <item name="android:drawableTint">@color/toolbar_action_text</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="UiToolbarIcon" parent="android:Widget.Material.ImageButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">13dp</item>
        <item name="android:background">@drawable/bg_toolbar_action</item>
        <item name="android:tint">@color/toolbar_action_text</item>
        <item name="android:scaleType">centerInside</item>
    </style>
</resources>
